# Example meshpoint-bridge settings. The real file is /etc/meshpoint-bridge/bridge.env,
# created by install.sh / --setup (mode 600, owned by the meshpoint-bridge user).
# Never commit the real file: it contains the dashboard password.

# Meshpoint dashboard username
MESHPOINT_USERNAME=admin
# Meshpoint dashboard password
MESHPOINT_PASSWORD=change-me

# Address the Meshtastic TCP API listens on (0.0.0.0 = all interfaces)
BRIDGE_LISTEN_HOST=0.0.0.0
# Meshtastic TCP API port
BRIDGE_LISTEN_PORT=4403
# Comma-separated IPs/networks allowed to connect, e.g. 192.168.1.0/24 (blank = anyone)
BRIDGE_ALLOW=
# Advertise the bridge to phones via mDNS (1/0)
BRIDGE_MDNS=1
# Advertise only this IPv4 address via mDNS (blank = automatic)
BRIDGE_ADVERTISE_IP=

# Receive-only: never transmit, reject sends from the app (1/0)
BRIDGE_RX_ONLY=0
# Node id to use only when Meshpoint reports none, e.g. !a1b2c3d4 (blank = MAC address)
BRIDGE_NODE_ID=
